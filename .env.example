POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://dateideas:REPLACE_WITH_STRONG_PASSWORD@db:5432/dateideas
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_API_KEY=replace-with-long-random-secret
# Веб-панель /admin включается только при заданных значениях
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Для публичного запуска задавайте только ADMIN_PASSWORD_HASH
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
PUBLIC_BASE_URL=
PUBLIC_DOMAIN=
SEARCH_DEFAULT_LIMIT=3
MOSCOW_TIMEZONE=Europe/Moscow
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_BUCKET=dateideas-media
MINIO_SECURE=false

# Опциональная OpenAI-совместимая модель (локальная vLLM тоже подходит)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=12

# OpenAI-compatible embeddings; модель должна возвращать ровно 384 измерения
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
INDEX_SCAN_SECONDS=120

# Telethon (необходимы для импорта из Telegram)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=/data/telegram.session
TELEGRAM_EDIT_SCAN_LIMIT=100
TELEGRAM_MEDIA_MAX_BYTES=8000000
# Публичный канал для пробной проверки: @kuda_v_moskva (сначала login)

# v0.11: интервалы периодических обработчиков, секунды.
DRAFT_SCAN_SECONDS=60
VERIFICATION_SCAN_SECONDS=3600

# Важно: POSTGRES_PASSWORD и пароль в DATABASE_URL должны совпадать.
