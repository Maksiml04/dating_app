# Только для изолированных E2E-тестов; не использовать в production.
FROM python:3.12-slim
WORKDIR /srv
COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir ".[telegram,dev]"
COPY alembic ./alembic
COPY alembic.ini ./
COPY tests ./tests
CMD ["sh", "-ec", "alembic upgrade head --sql >/dev/null && alembic upgrade head && pytest -q -m e2e tests/test_v018_e2e.py tests/test_fr_e2e_024.py"]
